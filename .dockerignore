# ================================================================
# VisionAI .dockerignore
# Exclude unnecessary files from Docker build context
# ================================================================

# Version control
.git
.gitignore
.gitattributes

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
nginx/certs/

# Documentation
*.md
LICENSE
CHANGELOG
docs/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js artifacts
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Docker files (prevent recursive builds)
docker-compose*.yml
Dockerfile*
.dockerignore

# ML model weights (mounted via volume, not baked into image)
models/*.pt
models/*.pth
models/*.onnx
models/*.engine
models/*.trt
models/*.bin
models/*.safetensors
models/*.h5
models/weights/
models/cache/

# Volume data
docker-volumes/
postgres_data/
redis_data/
minio_data/

# Testing
tests/
backend/tests/
**/__tests__/
**/test_*
**/*_test.*
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
playwright-report/
test-results/

# Logs and temp
logs/
*.log
tmp/
temp/
uploads/
recordings/
snapshots/
exports/

# Scripts not needed in containers
scripts/

# CI/CD
.github/
.gitlab-ci.yml
.circleci/
Jenkinsfile
Makefile
