# ──────────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
.cache/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

