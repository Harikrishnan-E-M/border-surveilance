# ================================================================
# VisionAI Environment Configuration
# Copy this file to .env and update values for your environment
# ================================================================

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=VisionAI
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=visionai
POSTGRES_PASSWORD=visionai_secret
POSTGRES_DB=visionai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://visionai:visionai_secret@localhost:5432/visionai

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_PASSWORD=visionai_redis
REDIS_PORT=6379
REDIS_URL=redis://:visionai_redis@localhost:6379/0

# ──────────────────────────────────────────────
# Celery
# ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://:visionai_redis@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:visionai_redis@localhost:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ──────────────────────────────────────────────
# MinIO Object Storage
# ──────────────────────────────────────────────
MINIO_ROOT_USER=visionai_minio
MINIO_ROOT_PASSWORD=visionai_minio_secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=visionai_minio
MINIO_SECRET_KEY=visionai_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET_SNAPSHOTS=snapshots
MINIO_BUCKET_RECORDINGS=recordings
MINIO_BUCKET_FACES=faces
MINIO_BUCKET_MODELS=models
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ──────────────────────────────────────────────
# MediaMTX (RTSP/HLS Streaming)
# ──────────────────────────────────────────────
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889

# ──────────────────────────────────────────────
# API Server
# ──────────────────────────────────────────────
API_PORT=8000
UVICORN_WORKERS=4
UVICORN_LOG_LEVEL=info

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_STREAM_URL=http://localhost:8888

# ──────────────────────────────────────────────
# Computer Vision / GPU
# ──────────────────────────────────────────────
CV_MODELS_PATH=./models
CV_USE_GPU=false
CV_GPU_DEVICE_ID=0
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=all
TORCH_CUDA_ARCH_LIST=
OMP_NUM_THREADS=4

# ──────────────────────────────────────────────
# Detection Thresholds
# ──────────────────────────────────────────────
DETECTION_CONFIDENCE_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.6
VEHICLE_DETECTION_THRESHOLD=0.5
PPE_DETECTION_THRESHOLD=0.5

# ──────────────────────────────────────────────
# Alert Configuration
# ──────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=60
ALERT_MAX_PER_CAMERA_PER_HOUR=100
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false

# ──────────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@visionai.com
SMTP_USE_TLS=true

# ──────────────────────────────────────────────
# Recording
# ──────────────────────────────────────────────
RECORDING_SEGMENT_DURATION=300
RECORDING_RETENTION_DAYS=30
RECORDING_FORMAT=mp4

# ──────────────────────────────────────────────
# AI Copilot (Anthropic Claude)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ──────────────────────────────────────────────
# Admin / First User
# ──────────────────────────────────────────────
ADMIN_EMAIL=admin@visionai.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
